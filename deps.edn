{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        io.github.hive-agi/hive-spi #:local{:root "../hive-spi"}
        io.github.hive-agi/hive-dsl #:local{:root "../hive-dsl"}}

 :aliases
 {
  ;; :build — tools.build entrypoint (clojure -T:build <task>). Canonical hive
  ;; build: jar / jar-aot / install / bump / verify-license / deploy.
  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.22"}}
          :ns-default hive-build.api}
:dev  {:extra-paths ["dev" "test"]
         :extra-deps  {org.clojure/test.check {:mvn/version "1.1.3"}}}

  :test {:extra-paths ["test"]
         :extra-deps  {org.clojure/test.check {:mvn/version "1.1.3"}
                       io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}}}
