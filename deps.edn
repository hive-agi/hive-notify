{:paths ["src"]

 ;; The private registry. Declared HERE, not only in a developer's user-level
 ;; deps.edn, so a cold clone and CI resolve hive-agi artifacts identically.
 ;; Credentials come from ~/.m2/settings.xml (server id "hive-gitea").
 :mvn/repos {"hive-gitea" {:url "https://gitea.hive-mcp.com/api/packages/hive-agi/maven"}}

 ;; Published pins only. For local development against sibling working trees,
 ;; pass -Sdeps with :local/root overrides (or a gitignored local.deps.edn);
 ;; CI's declared-classpath gate never applies them.
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        io.github.hive-agi/hive-spi {:mvn/version "1.4.18"}
        io.github.hive-agi/hive-dsl {:mvn/version "0.6.2"}
        ;; In-process freedesktop D-Bus (pure JDK unix socket, no JNI).
        com.github.hypfvieh/dbus-java-core {:mvn/version "5.2.2"}
        com.github.hypfvieh/dbus-java-transport-native-unixsocket {:mvn/version "5.2.2"}
        ;; Markdown → styled spans for the Ask inbox (see hive-notify.markup).
        ;; CommonMark AST only; the GTK side never sees Markdown source.
        org.commonmark/commonmark {:mvn/version "0.24.0"}
        ;; JSON lexing for fenced ```json blocks.
        org.clojure/data.json {:mvn/version "2.5.2"}}

 :aliases
 {;; :build — tools.build entrypoint (clojure -T:build <task>). Canonical hive
  ;; build: jar / jar-aot / install / bump / verify-license / deploy.
  :build {:deps {io.github.hive-agi/hive-build {:mvn/version "0.3.3"}}
          :ns-default hive-build.api}

  ;; :cljs -- ClojureScript toolchain, used ONLY to compile the GTK4/GJS ask
  ;; inbox helper (src-cljs/ -> src/hive_notify/ask_inbox.js). Not on the
  ;; production classpath; the compiled artifact is checked in, so neither this
  ;; alias nor ClojureScript is needed at runtime. Compile with:
  ;;   clojure -M:cljs -i script/compile_ask_inbox.clj
  :cljs {:extra-paths ["src-cljs"]
         :extra-deps  {org.clojure/clojurescript {:mvn/version "1.12.134"}}}

  :dev  {:extra-paths ["dev" "test"]
         :extra-deps  {org.clojure/test.check {:mvn/version "1.1.3"}}}

  :test {:extra-paths ["test"]
         :extra-deps  {org.clojure/test.check {:mvn/version "1.1.3"}
                       io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       io.github.hive-agi/hive-test {:mvn/version "0.5.2"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}}}
